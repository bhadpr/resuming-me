---
import type { Copy } from '../i18n/en'

interface Props {
  copy: Copy['try']
}

const { copy } = Astro.props
const glasses = 8
const waterMeta = copy.ofGlasses.replace('{value}', '1').replace('{target}', String(glasses))
---

<div
  class="today-card"
  data-today
  data-of={copy.ofGlasses}
  data-goal={copy.glasses}
  data-done={copy.done}
  data-undo={copy.undo}
  data-welcome={copy.welcome}
  data-all-done={copy.allDone}
  data-until="2026-11-10"
>
  <div class="today-card-head">
    <p class="mock-title">{copy.heading}</p>
  </div>
  <ul class="today-list">
    <li class="today-row" data-row="water" data-target={glasses} data-count="1">
      <img src="/habits/water.webp" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.water">{copy.water}</span>
        <span class="today-meta" data-meta>{waterMeta}</span>
        <span class="progress" aria-hidden="true"><span data-bar style="width: 12.5%"></span></span>
      </span>
      <button type="button" class="today-btn" data-action="count">{copy.glassButton}</button>
    </li>
    <li class="today-row" data-row="anulom">
      <img src="/habits/anuloma-viloma.webp" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.anulom">{copy.anulom}</span>
        <span class="today-meta" data-i18n="demo.anulom.detail">{copy.anulomMeta}</span>
      </span>
      <button type="button" class="today-btn" data-action="toggle" aria-pressed="false">{copy.done}</button>
    </li>
    <li class="today-row" data-row="diwali">
      <img src="/community/diwali.webp" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.diwali" data-until="2026-11-10" data-after={copy.diwaliAfter} data-after-i18n="demo.diwali.after">{copy.diwali}</span>
        <span class="today-meta" data-i18n="demo.diwali.detail" data-until="2026-11-10" data-after={copy.diwaliAfterMeta} data-after-i18n="demo.diwali.detail.after">{copy.diwaliMeta}</span>
      </span>
      <button type="button" class="today-btn" data-action="toggle" aria-pressed="false">{copy.done}</button>
    </li>
    <li class="today-row" data-row="cricket">
      <img src="/media/cricket-india.png" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.cricket">{copy.cricket}</span>
        <span class="today-meta" data-i18n="demo.cricket.detail">{copy.cricketMeta}</span>
      </span>
      <button type="button" class="today-btn" data-action="toggle" aria-pressed="false">{copy.done}</button>
    </li>
    <li class="today-row is-done" data-row="chai">
      <img src="/reminders/event.webp" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.chai">{copy.chai}</span>
        <span class="today-meta" data-i18n="demo.chai.detail">{copy.chaiMeta}</span>
      </span>
      <button type="button" class="today-btn" data-action="toggle" aria-pressed="true">{copy.undo}</button>
    </li>
    <li class="today-row quiet" data-row="reading">
      <img src="/habits/reading.webp" alt="" width="44" height="44" loading="lazy" />
      <span>
        <span class="today-name" data-i18n="demo.reading">{copy.reading}</span>
        <span class="today-meta" data-meta data-i18n="demo.reading.detail">{copy.readingMeta}</span>
      </span>
      <button type="button" class="today-btn" data-action="resume" aria-pressed="false">{copy.resume}</button>
    </li>
  </ul>
  <p class="today-status" data-status role="status" aria-live="polite"></p>
</div>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('[data-today]')) {
    if (card.dataset.bound === '1') continue
    card.dataset.bound = '1'
    const text = card.dataset
    const status = card.querySelector<HTMLElement>('[data-status]')!
    const rows = [...card.querySelectorAll<HTMLElement>('.today-row')]

    const refresh = () => {
      const allDone = rows.every((row) => row.classList.contains('is-done'))
      status.textContent = allDone ? text.allDone ?? '' : ''
    }

    for (const row of rows) {
      const button = row.querySelector<HTMLButtonElement>('button')!
      const meta = row.querySelector<HTMLElement>('[data-meta]')
      const quietLine = meta?.textContent ?? ''
      let count = Number(row.dataset.count ?? 0)

      button.addEventListener('click', () => {
        const action = button.dataset.action
        if (action === 'count') {
          const target = Number(row.dataset.target)
          count = count >= target ? 1 : count + 1
          const bar = row.querySelector<HTMLElement>('[data-bar]')!
          bar.style.width = `${(count / target) * 100}%`
          if (meta) {
            meta.textContent =
              count >= target
                ? (text.goal ?? '').replace('{target}', String(target))
                : (text.of ?? '').replace('{value}', String(count)).replace('{target}', String(target))
          }
          const done = count >= target
          row.classList.toggle('is-done', done)
          button.textContent = done ? text.done ?? '' : button.dataset.glass ?? button.textContent
          button.setAttribute('aria-pressed', String(done))
        } else {
          const done = button.getAttribute('aria-pressed') !== 'true'
          button.setAttribute('aria-pressed', String(done))
          row.classList.toggle('is-done', done)
          button.textContent = done ? text.undo ?? '' : action === 'resume' ? row.dataset.resumeLabel ?? '' : text.done ?? ''
          if (action === 'resume' && meta) {
            meta.textContent = done ? text.welcome ?? '' : quietLine
            row.classList.toggle('quiet', !done)
          }
        }
        refresh()
      })

      if (button.dataset.action === 'count') button.dataset.glass = button.textContent ?? ''
      if (button.dataset.action === 'resume') row.dataset.resumeLabel = button.textContent ?? ''
    }
  }
</script>
