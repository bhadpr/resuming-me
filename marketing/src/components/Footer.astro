---
import { APP_URL, CONTACT_EMAIL, SOCIAL_LINKS } from '../site'
import type { Copy } from '../i18n/en'

interface Props {
  copy: Copy
}

const { copy } = Astro.props
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <a class="brand" href="/" aria-label="Resuming">
        <img src="/logo.svg" alt="" width="34" height="34" />
        Resuming
      </a>
      <div class="footer-aside">
        <nav class="footer-social" aria-label="Social media">
          {SOCIAL_LINKS.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
              {link.id === 'facebook' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path fill="currentColor" d="M14 8h3V5h-3c-2.76 0-5 2.24-5 5v2H6v3h3v7h3v-7h3l1-3h-4V9c0-.55.45-1 1-1z" />
                </svg>
              )}
              {link.id === 'instagram' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path fill="currentColor" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm0 2a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H7zm5 3.5A4.5 4.5 0 1 1 7.5 13 4.5 4.5 0 0 1 12 8.5zm0 2A2.5 2.5 0 1 0 14.5 13 2.5 2.5 0 0 0 12 10.5zM17.25 6.75a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                </svg>
              )}
              {link.id === 'youtube' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path fill="currentColor" d="M23 12s0-3.2-.4-4.74a2.5 2.5 0 0 0-1.76-1.77C19.3 5.09 12 5.09 12 5.09s-7.3 0-8.84.4A2.5 2.5 0 0 0 1.4 7.26C1 8.8 1 12 1 12s0 3.2.4 4.74a2.5 2.5 0 0 0 1.76 1.77c1.54.4 8.84.4 8.84.4s7.3 0 8.84-.4a2.5 2.5 0 0 0 1.76-1.77C23 15.2 23 12 23 12zM9.75 15.02V8.98L15.5 12l-5.75 3.02z" />
                </svg>
              )}
            </a>
          ))}
        </nav>
        <nav class="footer-links" aria-label="Legal">
          <a href="/about/">{copy.footer.about}</a>
          <a href={`${APP_URL}/privacy`}>{copy.footer.privacy}</a>
          <a href={`${APP_URL}/terms`}>{copy.footer.terms}</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>{copy.footer.contact}</a>
          <button type="button" class="link-btn" data-consent-open hidden>{copy.footer.analyticsChoice}</button>
        </nav>
      </div>
    </div>
    <p>{copy.footer.disclaimer}</p>
    <p>© 2026 {copy.footer.company}</p>
  </div>
</footer>
