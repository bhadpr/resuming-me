---
import type { Copy } from '../i18n/en'

interface Props {
  copy: Copy['progress']['mock']
  lang: string
}

const { copy, lang } = Astro.props

type Status = 'done' | 'partial' | 'skipped' | 'open'
const STATUS: Record<string, Status> = { d: 'done', p: 'partial', s: 'skipped', o: 'open' }

/** Thirty days of a 20-minute walk, ending on a Sunday. Same rules as the app's chart. */
const TARGET = 20
const LAST_DAY = new Date(2026, 9, 11)
const MINUTES = [20, 22, 0, 18, 25, 20, 0, 0, 0, 10, 20, 21, 15, 22, 24, 0, 0, 12, 20, 25, 22, 0, 20, 22, 20, 0, 12, 25, 0, 21]
const STATUSES = 'ddspddooopddpddoopdddodddspdod'
const COMEBACKS = 2

const days = MINUTES.map((value, i) => {
  const date = new Date(LAST_DAY)
  date.setDate(LAST_DAY.getDate() - (MINUTES.length - 1 - i))
  return { value, status: STATUS[STATUSES[i]], date }
})

const fill = (template: string, values: Record<string, string | number>) =>
  template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''))
const weekday = new Intl.DateTimeFormat(lang, { weekday: 'short' })

function stats(points: typeof days) {
  const count = (status: Status) => points.filter((p) => p.status === status).length
  const avg = points.reduce((sum, p) => sum + p.value, 0) / points.length
  const done = count('done')
  const partial = count('partial')
  const skipped = count('skipped')
  return {
    rate: `${done + partial}/${points.length}`,
    desc: fill(copy.showedUp, { done: done + partial, scheduled: points.length, count: skipped }),
    avg: avg >= 10 ? Math.round(avg) : Math.round(avg * 10) / 10,
    caption: (avgText: number) =>
      fill(copy.caption, { done, partial, skipped, days: points.length, avg: avgText }),
  }
}

const week = days.slice(-7)
const weekStats = stats(week)
const weekHi = Math.max(TARGET, ...week.map((p) => p.value)) * 1.2

const monthStats = stats(days)
const monthHi = Math.max(TARGET, ...days.map((p) => p.value)) * 1.2
const svg = { width: 320, height: 150, padL: 28, padR: 12, padT: 14, padB: 28 }
const innerW = svg.width - svg.padL - svg.padR
const innerH = svg.height - svg.padT - svg.padB
const yAt = (value: number) => svg.padT + innerH - (value / monthHi) * innerH
const plotted = days.map((p, i) => ({ ...p, x: svg.padL + (i / (days.length - 1)) * innerW, y: yAt(p.value) }))
const polyline = plotted.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ')
const yTicks = [monthHi, monthHi / 2, 0].map((v) => Math.round(v * 10) / 10)
const avgY = yAt(monthStats.avg)
---

<div class="mock-card" data-insights>
  <div class="mock-head">
    <h3>{copy.heading}</h3>
    <div class="segmented" role="group">
      <button type="button" aria-pressed="true" data-window="week">{copy.days7}</button>
      <button type="button" aria-pressed="false" data-window="month">{copy.days30}</button>
    </div>
  </div>

  <p class="comeback-line">{fill(copy.comebacks, { count: COMEBACKS })}</p>

  <p class="mock-label">{copy.easiest}</p>

  <div class="ins-row" data-panel="week">
    <div class="ins-row-head">
      <img src="/habits/walking.webp" alt="" width="40" height="40" loading="lazy" />
      <span>
        <span class="today-name">{copy.habit}</span>
        <span class="today-meta">{weekStats.desc}</span>
      </span>
      <span class="ins-rate">{weekStats.rate}</span>
    </div>
    <div class="ins-bars" role="img" aria-label={copy.chartLabel} data-grow>
      {week.map((p) => (
        <div class="ins-bar-day">
          <span class="ins-bar-track">
            <span
              class={`ins-bar fill-${p.status}${p.value <= 0 ? ' is-empty' : ''}`}
              style={p.value <= 0 ? undefined : `height: ${Math.max(2, Math.round((p.value / weekHi) * 100))}%`}
            ></span>
          </span>
          <span class="ins-bar-label">{weekday.format(p.date)}</span>
        </div>
      ))}
    </div>
    <p class="ins-caption">{weekStats.caption(weekStats.avg)}</p>
  </div>

  <div class="ins-row" data-panel="month" hidden>
    <div class="ins-row-head">
      <img src="/habits/walking.webp" alt="" width="40" height="40" loading="lazy" />
      <span>
        <span class="today-name">{copy.habit}</span>
        <span class="today-meta">{monthStats.desc}</span>
      </span>
      <span class="ins-rate">{monthStats.rate}</span>
    </div>
    <svg class="ins-line" viewBox={`0 0 ${svg.width} ${svg.height}`} role="img" aria-label={copy.chartLabel}>
      {yTicks.map((tick) => (
        <g>
          <line x1={svg.padL} x2={svg.padL + innerW} y1={yAt(tick)} y2={yAt(tick)} class="grid" />
          <text x={svg.padL - 4} y={yAt(tick) + 3} text-anchor="end">{tick}</text>
        </g>
      ))}
      <line x1={svg.padL} x2={svg.padL + innerW} y1={yAt(TARGET)} y2={yAt(TARGET)} class="target" />
      <polyline points={polyline} class="trend" fill="none" />
      {plotted.map((p) => <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.5" class={`dot-${p.status}`} />)}
      <line x1={svg.padL} x2={svg.padL + innerW - 54} y1={avgY} y2={avgY} class="avg" />
      <rect x={svg.padL + innerW - 52} y={avgY - 9} width="52" height="12" rx="2" class="avg-bg" />
      <text x={svg.padL + innerW - 2} y={avgY + 1} text-anchor="end" dominant-baseline="middle" class="avg-label">
        {fill(copy.avg, { avg: monthStats.avg })}
      </text>
      {plotted.map((p, i) =>
        i === 0 || i === plotted.length - 1 || i % 5 === 0 ? (
          <text x={p.x.toFixed(1)} y={svg.height - 8} text-anchor="middle">
            {`${p.date.getMonth() + 1}/${p.date.getDate()}`}
          </text>
        ) : null,
      )}
    </svg>
    <p class="ins-caption">{monthStats.caption(monthStats.avg)}</p>
  </div>

  <p class="ins-legend" aria-hidden="true">
    <span><i class="fill-done"></i>{copy.done}</span>
    <span><i class="fill-partial"></i>{copy.partial}</span>
    <span><i class="fill-skipped"></i>{copy.skipped}</span>
    <span><i class="fill-open"></i>{copy.open}</span>
  </p>
</div>

<script>
  for (const card of document.querySelectorAll<HTMLElement>('[data-insights]')) {
    const buttons = [...card.querySelectorAll<HTMLButtonElement>('[data-window]')]
    const panels = [...card.querySelectorAll<HTMLElement>('[data-panel]')]
    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button))
        for (const panel of panels) panel.hidden = panel.dataset.panel !== button.dataset.window
      })
    }
  }
</script>
